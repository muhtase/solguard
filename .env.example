# Wajib — ambil dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# Opsional — batasi siapa yang boleh pakai bot (user id dipisah koma).
# Kosongkan = siapa pun boleh pakai.
ALLOWED_USER_IDS=

# RPC Solana. SANGAT DISARANKAN pakai endpoint sendiri (Helius punya free tier).
# Public RPC nolak batch getTransaction >3, jadi kolom arah beli/jual sering
# muncul "?" karena datanya gagal diambil.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Berapa transaksi per holder yang diperiksa buat nentuin arah beli/jual.
# Makin besar makin akurat tapi makin lambat & rawan rate limit. 0 = matikan.
FLOW_TX_PER_HOLDER=4

# Ukuran batch getTransaction. Public RPC max 3. Helius/QuickNode bisa 20+.
RPC_BATCH_SIZE=3
RPC_BATCH_PACE=0.12

# Ambang deteksi cluster "bundle" — yang menentukan kepadatan, bukan total.
# Cluster dianggap bundle kalau: wallet <= MAX, rata-rata %/wallet >= MIN_PCT,
# dan total suplai yang dipegang >= MIN_TOTAL.
BUNDLE_MAX_WALLETS=300
BUNDLE_MIN_PCT_PER_WALLET=0.05
BUNDLE_MIN_TOTAL_PCT=1.0

# Ambang minimum likuiditas (USD) sebelum token dianggap tidak layak trade
MIN_LIQUIDITY_USD=3000

# TTL cache hasil analisa (detik)
CACHE_TTL=90
